# ============================================================
# ELISA — Backend ELOMUX
# Variables de Entorno (plantilla para desarrolladores)
# ============================================================
# Copiar este archivo como .env y completar los valores
# cp .env.example .env
# ============================================================

# ─── Django ─────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here         # Clave secreta de Django (cambiar en producción)
DEBUG=True                               # Modo depuración (False en producción)
ALLOWED_HOSTS=localhost,127.0.0.1       # Hosts permitidos separados por coma

# ─── Base de Datos (PostgreSQL) ─────────────────────────────
DB_ENGINE=postgresql                     # Motor de base de datos
DB_NAME=elisa_db                         # Nombre de la base de datos
DB_USER=elisa_user                       # Usuario de la base de datos
DB_PASSWORD=your-db-password             # Contraseña del usuario
DB_HOST=127.0.0.1                        # Host de la base de datos
DB_PORT=5432                             # Puerto de la base de datos

# ─── CORS ────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── JWT (Autenticación) ────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30           # Minutos de expiración del access token
REFRESH_TOKEN_EXPIRE_HOURS=24            # Horas de expiración del refresh token

# ─── Alertas y Notificaciones ───────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=alertas@elomux.com
ALERT_EMAIL_RECIPIENTS=admin@elomux.com,gerencia@elomux.com
ALERT_WHATSAPP_NUMBER=                   # Número de WhatsApp para alertas (opcional)
